{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typr",
  "version": "0.1.0",
  "identifier": "com.typr.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Typr",
        "width": 900,
        "height": 600,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/whisper-cpp", "binaries/whisper-server"],
    "resources": {
      "binaries/whisper-dist/Release/ggml.dll": "ggml.dll",
      "binaries/whisper-dist/Release/ggml-base.dll": "ggml-base.dll",
      "binaries/whisper-dist/Release/ggml-cpu-alderlake.dll": "ggml-cpu-alderlake.dll",
      "binaries/whisper-dist/Release/ggml-cpu-cannonlake.dll": "ggml-cpu-cannonlake.dll",
      "binaries/whisper-dist/Release/ggml-cpu-cascadelake.dll": "ggml-cpu-cascadelake.dll",
      "binaries/whisper-dist/Release/ggml-cpu-haswell.dll": "ggml-cpu-haswell.dll",
      "binaries/whisper-dist/Release/ggml-cpu-icelake.dll": "ggml-cpu-icelake.dll",
      "binaries/whisper-dist/Release/ggml-cpu-sandybridge.dll": "ggml-cpu-sandybridge.dll",
      "binaries/whisper-dist/Release/ggml-cpu-skylakex.dll": "ggml-cpu-skylakex.dll",
      "binaries/whisper-dist/Release/ggml-cpu-sse42.dll": "ggml-cpu-sse42.dll",
      "binaries/whisper-dist/Release/ggml-cpu-x64.dll": "ggml-cpu-x64.dll",
      "binaries/whisper-dist/Release/whisper.dll": "whisper.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
